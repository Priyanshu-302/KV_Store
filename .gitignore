# ==============================================================================
# In-Memory Key-Value Store (.gitignore)
# ==============================================================================

# --- Build Artifacts & CMake Directories ---
build/
bin/
lib/
out/
target/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
Testing/

# --- Dependency FetchContent Cache ---
_deps/
submodules/

# --- Runtime Data & Persistence Files ---
# Prevent generated AOF logs and snapshots from being tracked
*.aof
appendonly.aof
*.rdb
dump.rdb
*.log

# --- IDEs, Tooling & OS Metadata ---
.vscode/
.idea/
.vs/
*.user
*.swp
*~
.DS_Store
Thumbs.db

# --- Crash Dumps & Diagnostics ---
core
core.*
vgcore.*
*.valgrind
